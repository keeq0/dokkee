POSTGRES_DB=dokkee
POSTGRES_PORT=5433
DATABASE_URL=postgres://dokkee:dokkee_secret@postgres:5432/dokkee?sslmode=disable

# Backend
PORT=8000
sign_key=dev-jwt-secret-please-change
salt=dev-salt-please-change

